def ignore(w: Wide, x: Nat) -> Nat: x
def loop(n: Nat, acc: Nat) -> Nat:
  match n:
    case Zero{}: acc
    case Succ{+k}: loop(k, ignore(make(k), acc + 1n))

def main() -> IO(Unit):
  IO.print(Nat.show(loop(20000n, 0n)))
