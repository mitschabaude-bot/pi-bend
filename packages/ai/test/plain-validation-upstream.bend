import Base
import ./plain-validation.bend as T
import ../../runtime/src/schema-value.bend as V
import ../../runtime/src/record.bend as R
import ../../runtime/src/f64.bend as F

# Original named test and all fifteen assertions from validation.test.ts.
def main() -> IO(Unit):
  do IO<Unit>:
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{"42"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"number"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(1078263808, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"42"}} <> Nil{}}}, "AJV-compatible primitive rules 1")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Boolean{True{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"number"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(1072693248, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{True{}}} <> Nil{}}}, "AJV-compatible primitive rules 2")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"number"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(0, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, "AJV-compatible primitive rules 3")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{"42"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"integer"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(1078263808, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"42"}} <> Nil{}}}, "AJV-compatible primitive rules 4")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{"true"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"boolean"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{True{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"true"}} <> Nil{}}}, "AJV-compatible primitive rules 5")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{"false"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"boolean"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{False{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"false"}} <> Nil{}}}, "AJV-compatible primitive rules 6")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(1072693248, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"boolean"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{True{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(1072693248, 0)}} <> Nil{}}}, "AJV-compatible primitive rules 7")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(0, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"boolean"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{False{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(0, 0)}} <> Nil{}}}, "AJV-compatible primitive rules 8")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"string"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{""}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, "AJV-compatible primitive rules 9")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Boolean{True{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"string"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"true"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{True{}}} <> Nil{}}}, "AJV-compatible primitive rules 10")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{""}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"null"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{""}} <> Nil{}}}, "AJV-compatible primitive rules 11")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(0, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"null"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(0, 0)}} <> Nil{}}}, "AJV-compatible primitive rules 12")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Boolean{False{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.Text{"null"}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Null{}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Boolean{False{}}} <> Nil{}}}, "AJV-compatible primitive rules 13")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{"1"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.ArrayValue{V.Text{"number"} <> V.Text{"string"} <> Nil{}}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"1"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"1"}} <> Nil{}}}, "AJV-compatible primitive rules 14")
    T.check(V.ObjectValue{R.Record{R.Property{"value", V.Text{"1"}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"type", V.Text{"object"}} <> R.Property{"properties", V.ObjectValue{R.Record{R.Property{"value", V.ObjectValue{R.Record{R.Property{"type", V.ArrayValue{V.Text{"boolean"} <> V.Text{"number"} <> Nil{}}} <> Nil{}}}} <> Nil{}}}} <> R.Property{"required", V.ArrayValue{V.Text{"value"} <> Nil{}}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Number{F.fromBits(1072693248, 0)}} <> Nil{}}}, V.ObjectValue{R.Record{R.Property{"value", V.Text{"1"}} <> Nil{}}}, "AJV-compatible primitive rules 15")
    IO.print("PASS coerces serialized plain JSON schemas with AJV-compatible primitive rules (15 assertions)")
