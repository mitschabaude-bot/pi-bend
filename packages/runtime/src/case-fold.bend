# END GENERATED UNICODE TABLE

def shifted(+code: U32, segment: Maybe<&2,Segment>) -> U32:
  match segment:
    case None{}: code
    case Some{Segment{first,last,even,odd}}:
      Bool.pick(U32,U32.is_le(code,last),(code + Bool.pick(U32,U32.is_eq(U32.and((code - first : U32),1),0),even,odd) : U32),code)

def next(+code: U32) -> U32: shifted(code,Table.floor(Segment,segments(),code))

def cycle(fuel: Nat, +first: U32, +code: U32) -> List<&2,Char>:
  match fuel:
    case 0n: Nil{}
    case 1n+rest:
      +following = next(code)
      Chr{code} <> Bool.pick(Unit -> List<&2,Char>,U32.is_eq(first,following),_ => Nil{},_ => cycle(rest,first,following))(Unit{})

# Input first, then its other equivalents; no normalization or multi-char folds.
def variants(char: Char) -> List<&2,Char>:
  +code = Char.to_u32(char)
  cycle(4n,code,code)

def contains(+char: Char, values: List<&2,Char>) -> Bool:
  match values:
    case Nil{}: False{}
    case head <> rest: Char.is_eq(char,head) || contains(char,rest)

def equal(+a: Char, +b: Char) -> Bool:
  Bool.pick(Unit -> Bool,Char.is_eq(a,b),_ => True{},_ => contains(b,variants(a)))(Unit{})

