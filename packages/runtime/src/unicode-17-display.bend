def rgiTail(+char: Char,rest: String) -> Bool:
  match rest:
    case SNil{}: U32.is_ne(U32.and(properties(Char.to_u32(char)),64),0)
    case +rest: Bool.pick(Unit -> Bool,U32.is_ne(U32.and(properties(Char.to_u32(char)),128),0),_ => emojiCandidates(emojiHash(SCon{char,rest},2166136261),SCon{char,rest}),_ => False{})(Unit{})
def isRgiEmoji(text: String) -> Bool:
  match text:
    case SNil{}: False{}
    case SCon{char,rest}: rgiTail(char,rest)
