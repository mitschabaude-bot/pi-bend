+// The high word of a 32x32 product in doubles: every partial product and
+// sum stays below 2^53, so the result is exact.
+function u32_mul_hi(a, b) {
+  const ah = a >>> 16, al = a & 65535, bh = b >>> 16, bl = b & 65535;
+  const low = al * bl, mid = ah * bl + al * bh;
+  return (ah * bh + Math.floor(mid / 65536)
+    + Math.floor((low + (mid % 65536) * 65536) / 4294967296)) >>> 0;
+}
