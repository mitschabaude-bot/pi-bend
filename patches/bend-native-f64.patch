+// At a power of two the interval that reads back as v is lopsided, so the
+// nearest p-digit decimal can miss while its neighbour lands: try the
+// mantissa one unit up or down in its last digit (a carry past the leading
+// digit means a shorter spelling, found at a smaller p).
+static int f64_nudge(char* buf, int dir, double v) {
+  char alt[40];
+  strcpy(alt, buf);
+  char* ep = strchr(alt, 'e');
+  for (char* d = ep - 1; d >= alt; d -= 1) {
+    if (*d == '.' || *d == '-') {
+      continue;
+    }
+    *d += dir;
+    if (*d >= '0' && *d <= '9') {
+      if (strtod(alt, NULL) == v) {
+        strcpy(buf, alt);
+        return 1;
+      }
+      return 0;
+    }
+    *d = dir > 0 ? '0' : '9';
+  }
+  return 0;
+}
+
+// The fewest significant digits that read back exactly (at most 17), laid
+// out as JavaScript does: exponential at or above 1e21 and below 1e-6.
+static int f64_text(char* buf, double v) {
+  int n = 0;
+  int p = 0;
+  if (v != v) {
+    return sprintf(buf, "nan");
+  }
+  if (v == 1.0 / 0.0 || v == -1.0 / 0.0) {
+    return sprintf(buf, v < 0 ? "-inf" : "inf");
+  }
+  if (v == 0.0) {
+    return sprintf(buf, signbit(v) ? "-0" : "0");
+  }
+  for (; p < 17; p += 1) {
+    n = snprintf(buf, 40, "%.*e", p, v);
+    if (strtod(buf, NULL) == v || f64_nudge(buf, 1, v) || f64_nudge(buf, -1, v)) {
+      break;
+    }
+    n = snprintf(buf, 40, "%.*e", p, v);
+  }
+  n = (int)strlen(buf);
+  char* ep = strchr(buf, 'e');
+  int ex = atoi(ep + 1);
+  if (ex >= 21 || ex <= -7) {
+    n = (int)(ep - buf) + sprintf(ep, "e%c%d", ex < 0 ? '-' : '+', abs(ex));
+  } else if (ex < 0) {
+    n = snprintf(buf, 40, "%.*f", p - ex, v);
+  } else if (ex < p) {
+    n = snprintf(buf, 40, "%.*f", p - ex, v);
+  } else {
+    int s = *buf == '-';
+    memmove(buf + s + 1, buf + s + 2, p);
+    memset(buf + s + 1 + p, '0', ex - p);
+    n = s + 1 + ex;
+    buf[n] = 0;
+  }
+  return n;
+}
+
+static Term f64_show(Env e, Term h, Term l) {
+  char buf[40];
+  return io_str(e, buf, f64_text(buf, f64_of(e, h, l)));
