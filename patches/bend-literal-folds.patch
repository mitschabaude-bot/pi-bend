+// F64 arithmetic on literals, computed here as C computes it (IEEE
+// doubles), so that a value like 1/50 is a constant F64{high, low} and the
+// data holding it can be static. A NaN is left to run: its bits may differ.
+function fold_f64(k: Bend.Name, xs: HTerm[]): HTerm | null {
+  const dv = new DataView(new ArrayBuffer(8));
+  const val = (t: HTerm): number | null => {
+    const s = Bend.term_strip(t);
+    const [h, l] = s.$ === "Ctr" && s.k === "F64" && s.x.length === 2
+      ? s.x.map((x) => Bend.u32_from_term(x)) : [null, null];
+    if (h === null || l === null) return null;
+    dv.setUint32(0, h);
+    dv.setUint32(4, l);
+    return dv.getFloat64(0);
+  };
+  const op = eff_name(k);
+  const [a, b] = op === "u32_to_f64" && xs.length === 1
+    ? [Bend.u32_from_term(xs[0]), 0]
+    : op.startsWith("f64_") && xs.length === 2 ? xs.map(val) : [null, null];
+  const r = a === null || b === null ? null : op === "u32_to_f64" ? a
+    : op === "f64_add" ? a + b : op === "f64_sub" ? a - b
+    : op === "f64_mul" ? a * b : op === "f64_div" ? a / b : null;
+  if (r === null || Number.isNaN(r)) {
+    return null;
+  }
+  dv.setFloat64(0, r);
+  return Bend.Ctr("F64", [0, 4].map((at) =>
+    Bend.term_higher(Bend.u32_to_term(dv.getUint32(at)))));
+}
