+// The widest register bank: a def or closure segment with more words takes
+// its first ones on the stack, as a continuation takes its frame, so every
+// segment's C signature stays this narrow.
+const BANK = Number(process.env.BEND_BANK ?? "32");
+
+function seg_wide(n: number): Seg["frame"] {
+  return n > BANK ? { pop: n - BANK, at: [...Array(n - BANK).keys()] } : null;
+}
