--- /dev/null
+++ b/effs/is_terminal.c
@@ -0,0 +1,11 @@
+#include <unistd.h>
+
+// Whether a file descriptor refers to a terminal. Errors (EBADF, ENOTTY)
+// report false, as Node's tty.isatty does. The def returns a plain Bool.
+Term io_isterminal_run(Env e, Term* f, IoWork* w) {
+  return term_pak(isatty((int)(u32)f[0]) ? CID_TRUE : CID_FALSE, 0);
+}
+
+static void __attribute__((constructor)) io_isterminal_use(void) {
+  io_eff(CID_IO_ISTERMINAL, io_isterminal_run, 0);
+}
--- /dev/null
+++ b/effs/is_terminal.js
@@ -0,0 +1,5 @@
+// Separate compiler-backend implementation; native programs never invoke JS.
+// Bool values are plain JavaScript booleans on this backend.
+function io_isterminal(descriptor) {
+  return require("tty").isatty(descriptor);
+}
