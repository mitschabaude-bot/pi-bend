+    row.waiter = null; row.state = 3;
+    return io_tup(row.socket, {$: "Some", value: result});
+  }, more => {
+    const wait = {fd: row.socket, out: false, k, more: () => {
+      if (row.state === 2) {
+        row.waiter = null; row.state = 3;
+        return io_tup(row.socket, {$: "None"});
+      }
+      return more();
+    }};
