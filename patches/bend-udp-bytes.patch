+function udpread_wait(row, k) {
+  if (row.state === 3 || row.waiter !== null) throw Error("invalid UDP read owner");
+  if (row.state === 2) {
+    row.state = 3;
+    return io_tup(row.socket, {$: "None"});
+  }
