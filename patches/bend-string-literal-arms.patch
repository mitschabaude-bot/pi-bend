+// A String equals a literal's n code points: read in place, not taken.
+INLINE bool str_is(Env e, Term s, TABV u64* cs, u32 n) {
+  for (u32 i = 0; i < n; i += 1) {
+    if (term_aux(s) != CID_SCON) {
+      return false;
+    }
+    Loc l = term_peek(e, s);
+    if ((u32)e.mem[l] != (u32)cs[i]) {
+      return false;
+    }
+    s = e.mem[l + 1];
+  }
+  return term_aux(s) == CID_SNIL;
+}
