+#include <sys/stat.h>
+
+// Modification time in milliseconds since the Unix epoch, following links.
+// Nanoseconds truncate toward zero, as Node's stat.mtime.getTime() does.
+static void file_modified_call(IoWork* w) {
+  struct stat info;
+  io_sys_end(w, stat(w->data, &info));
+  if (w->code == 0) {
+    if (info.st_mtim.tv_sec < 0) w->code = EOVERFLOW;
+    else w->size = (u64)info.st_mtim.tv_sec * 1000u + (u64)info.st_mtim.tv_nsec / 1000000u;
+  }
+}
+
+static Term file_modified_pack(Env e, IoWork* w) {
+  free(w->data);
+  return w->code ? io_fail(e, w->code, NULL)
+    : io_done(e, io_tup(e, (u32)(w->size >> 32), (u32)w->size));
+}
+
+Term file_modified_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return file_modified_pack(e, w);
+  }
+  return io_work(w, file_modified_call, file_modified_pack);
+}
+
+static void __attribute__((constructor)) file_modified_use(void) {
+  io_eff(CID_FILE_MODIFIED, file_modified_run, 0);
+}
--- /dev/null
+++ b/bend2/effs/file_modified.js
@@ -0,0 +1,13 @@
+// Modification time in milliseconds since the Unix epoch, following links.
+function file_modified(path) {
+  const bytes = io_bytes(path);
+  if (bytes.includes(0)) return io_fail(process.platform === "darwin" ? 92 : 84);
+  try {
+    const ms = Math.floor(require("fs").statSync(bytes.length ? Buffer.from(bytes) : "").mtimeMs);
+    if (ms < 0) return io_fail(require("os").constants.errno.EOVERFLOW);
+    const value = BigInt(ms);
+    return io_done(io_tup(Number(value >> 32n), Number(value & 0xffffffffn)));
+  } catch (error) {
+    return io_fail(Math.abs(error.errno ?? 5));
+  }
+}
