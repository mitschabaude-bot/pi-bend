+# HOME when present (including empty), otherwise the effective user's passwd home.
+# Return raw bytes; text decoding and path normalization belong to the caller.
+def Directory.home_bytes() -> IO(Result<&1, &1, U32 & String, List<&2, U32>>):
+  import "./effs/directory_home_bytes.c"
+  import "./effs/directory_home_bytes.js"
--- /dev/null
+++ b/bend2/effs/directory_home_bytes.c
@@ -0,0 +1,50 @@
+#include <pwd.h>
+
+static void directory_home_bytes_call(IoWork* w) {
+  const char* home = getenv("HOME");
+  if (home) {
+    w->text = strdup(home);
+    w->code = w->text ? 0 : ENOMEM;
+    return;
+  }
+  for (size_t size = 2048;; size *= 2) {
+    char* buffer = malloc(size);
+    if (!buffer) { w->code = ENOMEM; return; }
+    struct passwd entry, *found = NULL;
+    int code;
+    do { code = getpwuid_r(geteuid(), &entry, buffer, size, &found); }
+    while (code == EINTR);
+    if (!code && found) {
+      w->text = strdup(entry.pw_dir);
+      w->code = w->text ? 0 : ENOMEM;
+    } else {
+      w->code = code ? code : ENOENT;
+    }
+    free(buffer);
+    if (code != ERANGE) return;
+    if (size > SIZE_MAX / 2) { w->code = ENOMEM; return; }
+  }
+}
+
+static Term directory_home_bytes_pack(Env e, IoWork* w) {
+  Term result;
+  if (w->code) {
+    result = io_fail(e, w->code, NULL);
+  } else {
+    Term bytes = term_pak(CID_NIL, 0);
+    for (size_t i = strlen(w->text); i > 0; i -= 1)
+      bytes = io_node(e, CID_CON, (uint8_t)w->text[i - 1], bytes, IO_HOTS & 16);
+    result = io_done(e, bytes);
+  }
+  free(w->text);
+  return result;
+}
+
+Term directory_home_bytes_run(Env e, Term* f, IoWork* w) {
+  w->text = NULL;
+  return io_work(w, directory_home_bytes_call, directory_home_bytes_pack);
+}
+
+static void __attribute__((constructor)) directory_home_bytes_use(void) {
+  io_eff(CID_DIRECTORY_HOME_BYTES, directory_home_bytes_run, 0);
+}
