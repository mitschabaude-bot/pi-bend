+++ b/bend2/effs/directory_home_bytes.js
@@ -0,0 +1,44 @@
+let io_home_library;
+function directory_home_bytes() {
+  // The passwd layout below is the Linux LP64 ABI (x86_64 and aarch64).
+  if (process.platform !== "linux" || !["x64", "arm64"].includes(process.arch))
+    return io_fail(38);
+  try {
+    const ffi = require("bun:ffi");
+    if (!io_home_library) io_home_library = ffi.dlopen("libc.so.6", {
+      getenv: {args: ["ptr"], returns: "ptr"},
+      geteuid: {args: [], returns: "u32"},
+      getpwuid_r: {args: ["u32", "ptr", "ptr", "u64", "ptr"], returns: "i32"},
+      strlen: {args: ["ptr"], returns: "u64"},
+    });
+    const os = io_home_library.symbols;
+    let pointer = os.getenv(ffi.ptr(Buffer.from("HOME\0")));
+    let storage;
+    if (!pointer) {
+      const entry = new BigUint64Array(6), found = new BigUint64Array(1);
+      for (let size = 2048;; size *= 2) {
+        storage = Buffer.alloc(size);
+        let code;
+        do {
+          code = os.getpwuid_r(os.geteuid(), ffi.ptr(entry), ffi.ptr(storage), size, ffi.ptr(found));
+        } while (code === 4);
+        if (code === 34) continue;
+        if (code) return io_fail(code);
+        if (found[0] === 0n) return io_fail(2);
+        pointer = Number(entry[4]); // offsetof(struct passwd, pw_dir) == 32
+        break;
+      }
+    }
+    const size = Number(os.strlen(pointer));
+    const bytes = size ? new Uint8Array(ffi.toArrayBuffer(pointer, 0, size)) : [];
+    let result = {$: "Nil"};
+    for (let i = bytes.length; i > 0; i -= 1)
+      result = {$: "Con", head: bytes[i - 1], tail: result};
+    // Keep the passwd backing buffer alive until all pointed-to bytes are copied.
+    if (storage) ffi.ptr(storage);
+    return io_done(result);
+  } catch (error) {
+    const code = error.errno ?? error.info?.errno;
+    return io_fail(Number.isInteger(code) && code !== 0 ? Math.abs(code) : 5);
+  }
+}
