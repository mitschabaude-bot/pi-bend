+// Each unit holds the spins its segments reach, not all of them: Clang
+// takes seconds per unit to read the unused ones.
+function compile_spins(fl: File, named: Set<string>[]): string[] {
+  const at = new Map(fl.spins.map((s) => [s[0], { s, us: new Set<number>() }]));
+  const reach = (u: number) => (r: string): void => {
+    const x = at.get(r);
+    if (x !== undefined && !x.us.has(u)) {
+      x.us.add(u);
+      x.s[2].forEach(reach(u));
+    }
+  };
+  named.forEach((refs, u) => refs.forEach(reach(u)));
+  const guard = (n: string, c: string) => at.get(n)!.us.has(named.length - 1)
+    ? c : [`#if ${["BEND_TUS == 1", "DEVICE", ...[...at.get(n)!.us].map((u) =>
+      `BEND_TU == ${u}`)].join(" || ")}`, c, "#endif"].join("\n");
+  return [fl.spins.map((s) => guard(s[0], s[1].split("\n")[0]
+    .replace(/ \{$/, ";"))).join("\n"), ...fl.spins.map((s) => guard(s[0], s[1]))];
+}
