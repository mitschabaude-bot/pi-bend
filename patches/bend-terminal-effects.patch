+#if defined(CID_TERMINAL_ACQUIRE) || defined(CID_TERMINAL_RESTORE)
+// The handler only observes lock-free atomics and writes to a nonblocking pipe.
+// Retirement closes its gate, restores the prior action, then joins any handler
+// already inside the gate before closing that fd. No reused-fd signal writes.
+_Static_assert(ATOMIC_INT_LOCK_FREE == 2, "terminal signal gate needs lock-free integers");
+static atomic_int terminal_signal_fd = -1;
+static atomic_uint terminal_signal_users;
+static struct {
+  bool live, raw, signal;
+  u32 generation;
+  int settings_fd, signal_write;
+  struct termios saved;
+  struct sigaction previous;
+} terminal_lease = { .settings_fd=-1, .signal_write=-1 };
+static void terminal_winch(int signal, siginfo_t* info, void* context) {
+  int saved_errno=errno;
+  atomic_fetch_add(&terminal_signal_users,1);
+  int fd=atomic_load(&terminal_signal_fd);
+  if (fd>=0) {
+    char byte=1; (void)write(fd,&byte,1);
+    struct sigaction old=terminal_lease.previous;
+    if (old.sa_handler!=SIG_DFL && old.sa_handler!=SIG_IGN) {
+      if (old.sa_flags & SA_SIGINFO) old.sa_sigaction(signal,info,context);
+      else old.sa_handler(signal);
+    }
+  }
+  atomic_fetch_sub(&terminal_signal_users,1);
+  errno=saved_errno;
+}
+static int terminal_owned_fd(int original, bool writing, bool* regular) {
+  struct stat before,after;
+  if (fstat(original,&before)<0) return -1;
+  // Regular files need their shared current position, and nonblocking mode is
+  // irrelevant to them. Reopening a FIFO/tty gives an independent flag set.
+  *regular=S_ISREG(before.st_mode);
+  if (*regular) return fcntl(original,F_DUPFD_CLOEXEC,3);
+  char path[64]; snprintf(path,sizeof(path),"/proc/self/fd/%d",original);
+  int fd=open(path,(writing ? O_WRONLY : O_RDONLY) | O_NONBLOCK | O_CLOEXEC | O_NOCTTY);
+  if (fd<0) return -1;
+  if (fstat(fd,&after)<0 || before.st_dev!=after.st_dev || before.st_ino!=after.st_ino
+      || before.st_rdev!=after.st_rdev || (before.st_mode&S_IFMT)!=(after.st_mode&S_IFMT)) {
+    int error=errno ? errno : ESTALE; close(fd); errno=error; return -1;
+  }
+  return fd;
+}
+static int terminal_restore_settings(void) {
+  int error=0;
+  if (terminal_lease.raw && tcsetattr(terminal_lease.settings_fd,TCSANOW,&terminal_lease.saved)<0) error=errno;
+  if (terminal_lease.settings_fd>=0 && close(terminal_lease.settings_fd)<0 && !error) error=errno;
+  terminal_lease.settings_fd=-1; terminal_lease.raw=false;
+  return error;
+}
+#endif
+#ifdef CID_TERMINAL_ACQUIRE
+Term terminal_acquire_run(Env e, Term* f, IoWork* w) {
+  if (terminal_lease.live) return io_fail(e,EBUSY,NULL);
+  // A failed restore may leave our gated-off handler installed. Repair it
+  // before capturing a new prior action, never chain the handler to itself.
+  if (terminal_lease.signal) {
+    struct sigaction current;
+    if (sigaction(SIGWINCH,NULL,&current)<0) return io_fail(e,errno,NULL);
+    if ((current.sa_flags & SA_SIGINFO) && current.sa_sigaction==terminal_winch
+        && sigaction(SIGWINCH,&terminal_lease.previous,NULL)<0) return io_fail(e,errno,NULL);
+    terminal_lease.signal=false;
+  }
+  if (f[0]>INT_MAX || f[1]>INT_MAX) return io_fail(e,EBADF,NULL);
+  int input=-1,output=-1,notify[2]={-1,-1},error=0;
+  terminal_lease.live=true;
+  bool input_regular=false,output_regular=false;
+  input=terminal_owned_fd((int)f[0],false,&input_regular);
+  if (input<0) { error=errno; goto fail; }
+  output=terminal_owned_fd((int)f[1],true,&output_regular);
+  if (output<0) { error=errno; goto fail; }
+  terminal_lease.settings_fd=fcntl((int)f[0],F_DUPFD_CLOEXEC,3);
+  if (terminal_lease.settings_fd<0) { error=errno; goto fail; }
+  if (tcgetattr(terminal_lease.settings_fd,&terminal_lease.saved)==0) {
+    struct termios raw=terminal_lease.saved;
+    cfmakeraw(&raw);
+    terminal_lease.raw=true;
+    if (tcsetattr(terminal_lease.settings_fd,TCSANOW,&raw)<0) { error=errno; goto fail; }
+  } else if (errno!=ENOTTY) { error=errno; goto fail; }
+  if (pipe2(notify,O_NONBLOCK | O_CLOEXEC)<0) { error=errno; goto fail; }
+  struct sigaction action={0};
+  sigemptyset(&action.sa_mask); action.sa_sigaction=terminal_winch;
+  action.sa_flags=SA_SIGINFO | SA_RESTART;
+  // Publish the prior action before making our handler visible to any thread.
+  if (sigaction(SIGWINCH,NULL,&terminal_lease.previous)<0) { error=errno; goto fail; }
+  atomic_store(&terminal_signal_fd,notify[1]);
+  if (sigaction(SIGWINCH,&action,NULL)<0) { atomic_store(&terminal_signal_fd,-1); error=errno; goto fail; }
+  terminal_lease.signal=true; terminal_lease.signal_write=notify[1];
+  terminal_lease.generation++;
+  Term lease=io_hand(terminal_lease.generation);
+  Term in=process_resource(2,input), out=process_resource(1,output), resize=process_resource(2,notify[0]);
+  process_at(in,2)->regular=input_regular; process_at(out,1)->regular=output_regular;
+  return io_done(e,io_tup(e,lease,io_tup(e,io_tup(e,in,in),io_tup(e,io_tup(e,out,out),io_tup(e,resize,resize)))));
+ fail:
+  if (input>=0) close(input);
+  if (output>=0) close(output);
+  if (notify[0]>=0) close(notify[0]);
+  if (notify[1]>=0) close(notify[1]);
+  int restore=terminal_restore_settings();
+  terminal_lease.live=false;
+  if (restore) {
+    char message[256]; snprintf(message,sizeof(message),"terminal acquisition: %s; restoring settings: %s",strerror(error),strerror(restore));
+    return io_fail(e,error,message);
+  }
+  return io_fail(e,error,NULL);
+}
+static void __attribute__((constructor)) terminal_acquire_use(void) { io_eff(CID_TERMINAL_ACQUIRE,terminal_acquire_run,0); }
+#endif
+#ifdef CID_TERMINAL_RESTORE
+static void terminal_restore_call(IoWork* w) {
+  // Waiting only retires an actual in-flight signal handler, never polls size.
+  while (atomic_load(&terminal_signal_users)) sched_yield();
+  int error=0;
+  if (terminal_lease.signal_write>=0 && close(terminal_lease.signal_write)<0) error=errno;
+  terminal_lease.signal_write=-1;
+  int restore=terminal_restore_settings();
+  w->code=w->code ? w->code : error ? error : restore;
+}
+static Term terminal_restore_pack(Env e, IoWork* w) {
+  terminal_lease.live=false;
+  return w->code ? io_fail(e,w->code,NULL) : io_done(e,term_pak(CID_UNIT,0));
+}
+Term terminal_restore_run(Env e, Term* f, IoWork* w) {
+  if (!terminal_lease.live || io_hand_v(f[0])!=terminal_lease.generation) err_fail("invalid terminal lease");
+  w->code=0;
+  atomic_store(&terminal_signal_fd,-1);
+  struct sigaction current;
+  if (sigaction(SIGWINCH,NULL,&current)<0) w->code=errno;
+  else if (!(current.sa_flags & SA_SIGINFO) || current.sa_sigaction!=terminal_winch) { terminal_lease.signal=false; w->code=EBUSY; }
+  else if (sigaction(SIGWINCH,&terminal_lease.previous,NULL)<0) w->code=errno;
+  else terminal_lease.signal=false;
+  return io_work(w,terminal_restore_call,terminal_restore_pack);
+}
+static void __attribute__((constructor)) terminal_restore_use(void) { io_eff(CID_TERMINAL_RESTORE,terminal_restore_run,0); }
+#endif
+#ifdef CID_TERMINAL_DIMENSIONS
+Term terminal_dimensions_run(Env e, Term* f, IoWork* w) {
+  struct winsize size;
+  ProcessResource* output=process_at(f[0],1);
+  if (!output) return io_fail(e,EBADF,NULL);
+  if (ioctl(output->fd,TIOCGWINSZ,&size)<0) return io_fail(e,errno,NULL);
+  return io_done(e,io_tup(e,size.ws_col,size.ws_row));
+}
+static void __attribute__((constructor)) terminal_dimensions_use(void) { io_eff(CID_TERMINAL_DIMENSIONS,terminal_dimensions_run,0); }
+#endif
