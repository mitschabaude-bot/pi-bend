+++ b/bend2/effs/directory_create.js
@@ -0,0 +1,6 @@
+function directory_create(path) {
+  const bytes=io_bytes(path);
+  if(bytes.includes(0)) return io_fail(process.platform === "darwin" ? 92 : 84);
+  try { require("fs").mkdirSync(bytes.length ? Buffer.from(bytes) : ""); return io_done({$: "Unit"}); }
+  catch(error) { return io_fail(Math.abs(error.errno ?? 5)); }
+}
