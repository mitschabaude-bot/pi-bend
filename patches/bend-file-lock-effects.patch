+#include <sys/stat.h>
+static void directory_create_call(IoWork* w) { io_sys_end(w, mkdir(w->data, 0777)); }
+static Term directory_create_pack(Env e, IoWork* w) {
+  free(w->data);
+  return w->code ? io_fail(e,w->code,NULL) : io_done(e,term_pak(CID_UNIT,0));
+}
+Term directory_create_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e,f[0],&w->size);
+  if (io_nul(w->data,w->size)) { w->code=EILSEQ; return directory_create_pack(e,w); }
+  return io_work(w,directory_create_call,directory_create_pack);
+}
+static void __attribute__((constructor)) directory_create_use(void) { io_eff(CID_DIRECTORY_CREATE,directory_create_run,0); }
