+    let consumed = 1;
+    if (hole.startsWith("return ")) {
+      frame = [`$stack.push(($v) => (${hole.slice("return ".length, -1)}));`];
+    } else {
+      const rest: string[] = [];
+      let j = i + 1;
+      while (j < body.length && js_indent(body[j]) >= indent) {
+        rest.push(pad(2) + body[j].slice(indent));
+        j += 1;
+      }
+      consumed = j - i;
+      frame = ["$stack.push(($v) => {", pad(2) + hole, ...rest, "});"];
+    }
+    out.push(...frame.map((l) => pad(indent) + l), ...jumpTo(indent, args));
+    i += consumed;
+  }
