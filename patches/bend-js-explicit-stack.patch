+    // surrounding statement and the arm's remaining lines become the frame.
+    const argsOpen = at + call.length - 1;
+    const argsEnd = js_close(text, argsOpen);
+    const args = js_split_args(text.slice(argsOpen + 1, argsEnd - 1));
+    const callEnd = js_close(text, at + "run_loop".length);
+    const hole = text.slice(0, at) + "$v" + text.slice(callEnd);
