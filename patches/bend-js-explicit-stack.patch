+    "const $stack = [];",
+    "let $result;",
+    ...params.map((p, i) => `let $c${i} = ${p};`),
+    "$outer: while (true) {",
+    ...params.map((p, i) => pad(2) + `const ${p} = $c${i};`),
+    ...out.map((l) => pad(2) + l),
+    "}",
+    "$result = run_loop($result);",
+    "while ($stack.length > 0) $result = run_loop($stack.pop()($result));",
+    "return $result;",
+  ];
+}
