+function js_stackify(body: string[], token: string, params: string[]): string[] {
+  const call = "run_loop(" + token + "(";
+  const jump = "return run_jump(" + token + ", [";
+  const eligible = body.some((line) => !line.includes("run_clo(")
+    && (line.includes(call) || line.trimStart().startsWith(jump)));
+  if (!eligible) return body;
+  const pad = (n: number) => FILE_INDENT.slice(0, n);
+  // Each iteration rebinds the parameters as fresh constants so frames close
+  // over that iteration's values; the loop carries the next values apart.
+  const jumpTo = (indent: number, args: string[]): string[] => {
+    if (args.length !== params.length) die("a self-call arity mismatch in " + token);
+    const temps = args.map((a, i) => `const $a${i} = ${a};`);
+    const sets = params.map((_, i) => `$c${i} = $a${i};`);
+    return [...temps, ...sets, "continue $outer;"].map((l) => pad(indent) + l);
+  };
+  const out: string[] = [];
+  let i = 0;
+  while (i < body.length) {
+    const line = body[i];
+    const indent = js_indent(line);
+    const text = line.trim();
+    if (line.includes("run_clo(")) {
+      out.push(text.startsWith("return ")
+        ? pad(indent) + "$result = " + text.slice("return ".length, -1) + "; break $outer;"
+        : line);
+      i += 1;
+      continue;
+    }
+    if (text.startsWith(jump) && text.endsWith("]);")) {
+      out.push(...jumpTo(indent, js_split_args(text.slice(jump.length, -3))));
+      i += 1;
+      continue;
+    }
+    const at = text.indexOf(call);
+    if (at < 0) {
+      out.push(text.startsWith("return ")
+        ? pad(indent) + "$result = " + text.slice("return ".length, -1) + "; break $outer;"
+        : line);
+      i += 1;
+      continue;
+    }
