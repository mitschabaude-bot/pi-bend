+++ b/bend2/effs/file_write_bytes.js
@@ -0,0 +1,20 @@
+function file_write_bytes(file, data) {
+  const bytes = [];
+  for (let node = data; node.$ === "Con"; node = node.tail) {
+    if (node.head > 255) return io_tup(file, io_fail(22));
+    bytes.push(node.head);
+  }
+  const buffer = Uint8Array.from(bytes), fs = require("fs");
+  let at = 0;
+  while (at < buffer.length) {
+    try {
+      const written = fs.writeSync(file, buffer, at, buffer.length - at, null);
+      if (written === 0) return io_tup(file, io_fail(5));
+      at += written;
+    } catch (error) {
+      if (error.code === "EINTR") continue;
+      return io_tup(file, io_fail(Math.abs(error.errno ?? 5)));
+    }
+  }
+  return io_tup(file, io_done({$: "Unit"}));
+}
