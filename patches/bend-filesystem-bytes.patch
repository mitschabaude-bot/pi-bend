@@ -0,0 +1,11 @@
+function file_size_bytes(path) {
+  const bytes = io_bytes(path);
+  if (bytes.includes(0)) return io_fail(process.platform === "darwin" ? 92 : 84);
+  try {
+    const size = require("fs").statSync(bytes.length ? Buffer.from(bytes) : "", {bigint: true}).size;
+    if (size < 0n || size > 0xffffffffffffffffn) return io_fail(require("os").constants.errno.EOVERFLOW);
+    return io_done(io_tup(Number(size >> 32n), Number(size & 0xffffffffn)));
+  } catch (error) {
+    return io_fail(Math.abs(error.errno ?? 5));
+  }
+}
