@@ -0,0 +1,49 @@
+static void file_write_bytes_call(IoWork* w) {
+  u64 at = 0;
+  while (at < w->size) {
+    u64 remaining = w->size - at;
+    size_t count = remaining > INT32_MAX ? INT32_MAX : (size_t)remaining;
+    ssize_t n = write((int)w->hand, w->data + at, count);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) {
+      w->code = n < 0 ? errno : EIO;
+      return;
+    }
+    at += (u64)n;
+  }
+}
+
+static Term file_write_bytes_pack(Env e, IoWork* w) {
+  free(w->data);
+  Term result = w->code ? io_fail(e, w->code, NULL)
+    : io_done(e, term_pak(CID_UNIT, 0));
+  return io_tup(e, io_hand(w->hand), result);
+}
+
+Term file_write_bytes_run(Env e, Term* f, IoWork* w) {
+  w->code = 0;
+  w->hand = (intptr_t)io_hand_v(f[0]);
+  u64 capacity = 64;
+  w->data = io_mem(malloc(capacity));
+  w->size = 0;
+  Term bytes = f[1];
+  while (term_aux(bytes) == CID_CON) {
+    Term fields[2];
+    spare_free(e, cls_fit(2), ctr_take(e, bytes, 2, fields));
+    if (fields[0] > 255) w->code = EINVAL;
+    if (w->code == 0) {
+      if (w->size == capacity) {
+        capacity *= 2;
+        w->data = io_mem(realloc(w->data, capacity));
+      }
+      w->data[w->size++] = (char)fields[0];
+    }
+    bytes = fields[1];
+  }
+  return w->code ? file_write_bytes_pack(e, w)
+    : io_work(w, file_write_bytes_call, file_write_bytes_pack);
+}
+
+static void __attribute__((constructor)) file_write_bytes_use(void) {
+  io_eff(CID_FILE_WRITE_BYTES, file_write_bytes_run, 0);
+}
