+#include <sys/stat.h>
+
+static void file_size_bytes_call(IoWork* w) {
+  struct stat info;
+  io_sys_end(w, stat(w->data, &info));
+  if (w->code == 0) {
+    if (info.st_size < 0) w->code = EOVERFLOW;
+    else w->size = (u64)info.st_size;
+  }
+}
+
+static Term file_size_bytes_pack(Env e, IoWork* w) {
+  free(w->data);
+  return w->code ? io_fail(e, w->code, NULL)
+    : io_done(e, io_tup(e, (u32)(w->size >> 32), (u32)w->size));
+}
+
+Term file_size_bytes_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return file_size_bytes_pack(e, w);
+  }
+  return io_work(w, file_size_bytes_call, file_size_bytes_pack);
+}
+
+static void __attribute__((constructor)) file_size_bytes_use(void) {
+  io_eff(CID_FILE_SIZE_BYTES, file_size_bytes_run, 0);
+}
