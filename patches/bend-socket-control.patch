+# Duplicate the descriptor, retaining shared socket state. Both affine owners
+# must be closed. The new descriptor is close-on-exec.
+def Socket.duplicate(socket: Socket) ->
+  IO(Socket & Result<&1, &1, U32 & String, Socket>):
+  import "./effs/socket_duplicate.c"
+  import "./effs/socket_duplicate.js"
+
+# Shut down both directions, waking pending socket IO without closing either
+# descriptor. Callers retain ownership and must close after IO has settled.
+def TCP.shutdown(socket: Socket) ->
+  IO(Socket & Result<&1, &1, U32 & String, Unit>):
+  import "./effs/tcp_shutdown.c"
+  import "./effs/tcp_shutdown.js"
+
+# Classify the platform errno without hard-coding OS numbers in Bend libraries.
+def Socket.isConnectionReset(code: U32) -> IO(Bool):
+  import "./effs/socket_is_connection_reset.c"
+  import "./effs/socket_is_connection_reset.js"
+
 # Owned timer and independently copyable cancellation capability.
 # Wait returns the owner with True for expiry or False for cancellation.
 # Cancellation wins until completion is committed by the IO loop. Close
--- /dev/null
+++ b/effs/socket_duplicate.c
@@ -0,0 +1,10 @@
+Term socket_duplicate_run(Env e, Term* f, IoWork* w) {
+  int fd = (int)io_hand_v(f[0]);
+  int copy = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+  Term result = copy < 0 ? io_fail(e, errno, NULL) : io_done(e, io_hand(copy));
+  return io_tup(e, io_hand(fd), result);
+}
+
+static void __attribute__((constructor)) socket_duplicate_use(void) {
+  io_eff(CID_SOCKET_DUPLICATE, socket_duplicate_run, 0);
+}
--- /dev/null
+++ b/effs/socket_duplicate.js
@@ -0,0 +1,5 @@
+function socket_duplicate(socket) {
+  const sys = io_sys();
+  const copy = sys.fcntl(socket, sys.mac ? 67 : 1030, 0);
+  return io_tup(socket, copy < 0 ? io_fail(sys.errno()) : io_done(copy));
+}
