+# Directory snapshot in OS order, excluding dot entries. Names are raw bytes.
+# Kind codes: 0 other, 1 regular file, 2 directory, 3 symbolic link.
+def Directory.read_bytes(path: String) -> IO(Result<&1, &1, U32 & String, List<(List<&2, U32> & U32)>>):
+  import "./effs/directory_read_bytes.c"
+  import "./effs/directory_read_bytes.js"
