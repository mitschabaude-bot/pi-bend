+  const target = ".";
+  try {
+    const bytes = require("fs").realpathSync.native(target, {encoding: "buffer"});
+    let xs = {$: "Nil"};
+    for (let i = bytes.length; i > 0; i -= 1) xs = {$: "Con", head: bytes[i - 1], tail: xs};
