+static void directory_current_bytes_call(IoWork* w) {
+  w->text = getcwd(NULL, 0);
+  w->code = w->text ? 0 : errno;
+}
+
+static Term directory_current_bytes_pack(Env e, IoWork* w) {
+  Term result;
+  if (w->code) {
+    result = io_fail(e, w->code, NULL);
+  } else {
+    Term bytes = term_pak(CID_NIL, 0);
+    for (u64 i = strlen(w->text); i > 0; i -= 1) {
+      bytes = io_node(e, CID_CON, (uint8_t)w->text[i - 1], bytes, IO_HOTS & 16);
+    }
+    result = io_done(e, bytes);
+  }
+  free(w->text);
+  return result;
+}
+
+Term directory_current_bytes_run(Env e, Term* f, IoWork* w) {
+  w->text = NULL;
+  return io_work(w, directory_current_bytes_call, directory_current_bytes_pack);
+}
+
+static void __attribute__((constructor)) directory_current_bytes_use(void) {
+  io_eff(CID_DIRECTORY_CURRENT_BYTES, directory_current_bytes_run, 0);
+}
