+#include <stdlib.h>
+static void directory_mkdtemp_call(IoWork* w) {
+  if (!mkdtemp(w->data)) w->code=errno;
+}
+static Term directory_mkdtemp_pack(Env e, IoWork* w) {
+  Term result=w->code ? io_fail(e,w->code,NULL) : io_done(e,io_str(e,w->data,strlen(w->data)));
+  free(w->data);
+  return result;
+}
+Term directory_mkdtemp_run(Env e, Term* f, IoWork* w) {
+  w->data=io_cstr(e,f[0],&w->size);
+  w->code=io_nul(w->data,w->size) ? EILSEQ : 0;
+  return w->code ? directory_mkdtemp_pack(e,w) : io_work(w,directory_mkdtemp_call,directory_mkdtemp_pack);
+}
+static void __attribute__((constructor)) directory_mkdtemp_use(void) { io_eff(CID_DIRECTORY_MKDTEMP,directory_mkdtemp_run,0); }
