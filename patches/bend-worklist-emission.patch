+function unit_of(fl: File, k: Bend.Name): { segs: Seg[]; spins: Spun[] } {
+  return memo(fl.units, k, () => ({ segs: [], spins: [] }));
+}
+
+// A segment belongs to the unit being emitted: a def's own, or, within a
+// spin, the spin's callee (closures a spin body makes included).
+function seg_push(fl: File, seg: Seg): void {
+  fl.segs.push(seg);
+  if (UNIT !== "") unit_of(fl, UNIT).segs.push(seg);
+}
+
+// Emits a unit afresh: its segments, its spins (with their names kept, as
+// their callers hold them) and the facts it gave are dropped first.
+function compile_unit(fl: File, k: Bend.Name, tld: Def): void {
+  const unit = unit_of(fl, k);
+  const old = new Set(unit.segs);
+  fl.segs = fl.segs.filter((s) => !old.has(s));
+  const names = new Set(unit.spins.map((s) => s.name));
+  fl.spins = fl.spins.filter(([n]) => !names.has(n));
+  for (const s of unit.spins) fl.spun.delete(s.key);
+  // own, hot and stat only grow; lend is what the current outputs lend.
+  fl.lend.forget(k);
+  unit.segs = [];
+  UNIT = k;
+  compile_def(fl, k, tld);
+  for (const s of unit.spins) emit_native(fl, s.ck, s.ers, s);
+  UNIT = "";
+}
