+      rs === undefined ? this.readers.set(k, new Set([UNIT])) : rs.add(UNIT);
+    }
+    return super.has(k);
+  }
+  add(k: string): this {
+    if (!super.has(k)) {
+      super.add(k);
+      this.readers.get(k)?.forEach((u) => DIRTY.add(u));
+    }
+    if (UNIT !== "") {
+      const gs = this.gave.get(UNIT);
+      gs === undefined ? this.gave.set(UNIT, new Set([k])) : gs.add(k);
+    }
+    return this;
+  }
+  // Drops what a unit contributed, ahead of its re-emission.
+  forget(u: Bend.Name): void {
+    this.gave.get(u)?.forEach((k) => super.delete(k));
+    this.gave.delete(u);
+  }
