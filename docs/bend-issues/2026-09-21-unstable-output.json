{
  "status": "Adopted in ordinary/default native compilers after rejecting completed-segment compaction.",
  "patch": "--- a/comp.ts\n+++ b/comp.ts\n@@ -71,6 +71,7 @@\n };\n \n type File = Carb & {\n+  emit: boolean;\n   spares: { words: number; name: string; z: boolean }[];\n   fresh: Map<string, number>;\n   uses: Map<Probe, Bind>;\n@@ -1527,7 +1528,7 @@\n // ====\n \n function file_new(cb: Carb, decl: string): File {\n-  return { ...cb, decl, segs: [], seg: seg_new(\"\", BOX, []), tab: 2,\n+  return { ...cb, emit: true, decl, segs: [], seg: seg_new(\"\", BOX, []), tab: 2,\n     cids: new Map(), tabs: new Map(), spins: [], spun: new Map(), clos: new Set(),\n     img: [], lits: new Map(), reqs: \"\", fuel: 0, fresh: new Map(), spares: [],\n     uses: new Map(), brwl: new Map(), rest: [], def: \"\" };\n@@ -1536,7 +1537,7 @@\n const FILE_INDENT = \"  \".repeat(16);\n \n function file_push(fl: File, line: string): void {\n-  fl.seg.lines.push(FILE_INDENT.slice(0, fl.tab * 2) + line);\n+  if (fl.emit) fl.seg.lines.push(FILE_INDENT.slice(0, fl.tab * 2) + line);\n }\n \n // Block\n@@ -2188,14 +2189,14 @@\n   seg.fid = name;\n   const dst = val_new(seg.ret.ks.map(() => name_local(fl, \"v\")), seg.ret);\n   emit_body(fl, tld.h as HTerm, tld.T, ers, vals, dst);\n-  fl.spins.push([name, [`${seg.lines.length < SPIN_FAR ? \"INLINE\" : \"FAR\"} Term ${name}(Env e, THR Term* o${\n+  fl.spins.push([name, fl.emit ? [`${seg.lines.length < SPIN_FAR ? \"INLINE\" : \"FAR\"} Term ${name}(Env e, THR Term* o${\n     seg.ks.map((k, i) => `, ${lay_c(k)} r${i}`).join(\"\")}) {`,\n   \"  u32 wpoll = 0;\",\n   ...dst.ws.map((v, j) => `  ${lay_c(seg.ret.ks[j])} ${v} = 0;`),\n   ...seg_take(seg).map((l) => \"  \" + l),\n   \"  WL_SPIN\", ...seg.lines, \"  break;\", \"  }\",\n   ...dst.ws.map((v, j) => `  o[${j}] = ${v};`),\n-  \"  return 1;\", \"}\"].join(\"\\n\"), seg.refs]);\n+  \"  return 1;\", \"}\"].join(\"\\n\") : \"\", seg.refs]);\n   Object.assign(fl, outer);\n   return name;\n }\n@@ -2880,6 +2881,7 @@\n   const pass = (defs: [Bend.Name, Def][]): File => {\n     [cb.lend, BRWS].forEach((m) => m.clear());\n     const fl = file_new(cb, \"Term\");\n+    const count = cb.own.size + cb.hot.size + cb.stat.size;\n     for (const k of SRCS.keys()) {\n       for (const c of (cb.book.tlds[k] as Bend.ADT).c ?? []) {\n         fl.cids.set(c.k, lay_node(fl.book, c.k).ks.length);\n@@ -2887,6 +2889,12 @@\n     }\n     for (const [k, tld] of defs) {\n       compile_def(fl, k, tld);\n+      // These sets only grow: once they change, this pass's source is discarded.\n+      if (fl.emit && count !== cb.own.size + cb.hot.size + cb.stat.size) {\n+        fl.emit = false;\n+        for (const seg of fl.segs) seg.lines = [];\n+        for (const spin of fl.spins) spin[1] = \"\";\n+      }\n     }\n     compile_reqs(fl);\n     facts_lend(cb);\n",
  "source_audit": [
    "own/hot/stat are monotonic sets: all writes found are add; no clear/delete or assignments during a compile. Their summed sizes detect that the current pass is already unstable.",
    "compile_def still performs all analysis and emission computations. Only retention in file_push is skipped after instability is known.",
    "Prior Seg.lines and spin source strings are cleared once. Segment metadata, names, references, layouts and optimization facts remain.",
    "Native Seg.lines is otherwise read only to form spin text, its inline/far declaration, and final C. Spin text is read only after convergence.",
    "Nested emit_native saves/restores File state, but instability is marked only between top-level definitions, after nested emission returns.",
    "Foreign request processing and facts_lend still run. If they discover the first change, existing end-pass handling discards the File normally.",
    "JavaScript file_new starts emit=true and never enters the native pass loop, so its emitted text is unchanged."
  ],
