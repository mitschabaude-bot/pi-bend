  "instrumentation": {
    "count-first-pass.py": "from pathlib import Path\nimport shutil,re\nbase=Path('build/bend-native-toolchain/bend2');dst=Path('build/bend-profiles/first-pass-allocation-counts/bend2');shutil.copytree(base,dst)\np=dst/'bend.ts';s=p.read_text();s='export const allocationCounts: Record<string, number> = {};\\n'+s\nfor tag in ['Var','Ref','Sub','Let','Typ','Qnt','Qua','Min','All','Lam','App','ADT','Ctr','Mat','Efq','Eql','Rfl','Rwt','Hol','Ann','Emp','Bin','None','Lone','Many']:\n # Count actual object literal allocations, not cached factory returns.\n pat=r'(^  (?:return|const out =) \\{ \\$: \"'+tag+r'\",?)'\n s,n=re.subn(pat,lambda m:'  allocationCounts.'+tag+' = (allocationCounts.'+tag+' ?? 0) + 1;\\n'+m.group(0),s,flags=re.M)\n # Ctr's pooled allocation is indented four spaces.\n if tag=='Ctr':s=s.replace('    const out = { $: \"Ctr\",','    allocationCounts.Ctr = (allocationCounts.Ctr ?? 0) + 1;\\n    const out = { $: \"Ctr\",')\n assert n>=1,tag\np.write_text(s)\np=dst/'comp.ts';s=p.read_text()\ns=s.replace('  const cb = carb_book(book, [\"main\", ...RUNTIME_ADTS]);','  console.error(\"ALLOC_FRONT\", JSON.stringify(Bend.allocationCounts));\\n  const cb = carb_book(book, [\"main\", ...RUNTIME_ADTS]);\\n  console.error(\"ALLOC_CARB\", JSON.stringify(Bend.allocationCounts));')\ns=s.replace('      compile_def(fl, k, tld);','''      const before = {...Bend.allocationCounts};\n      compile_def(fl, k, tld);\n      const delta = Object.fromEntries(Object.entries(Bend.allocationCounts).map(([k,v])=>[k,v-(before[k]??0)]));\n      console.error(\"ALLOC_DEF\", JSON.stringify({name:k,delta}));''')\ns=s.replace('    fl = pass(done_defs(cb).reverse());','    fl = pass(done_defs(cb).reverse());\\n    console.error(\"ALLOC_PASS\", JSON.stringify(Bend.allocationCounts));\\n    process.exit(0);')\np.write_text(s)\n",
    "sample-allocation-stacks.py": "from pathlib import Path\nimport shutil,re\nbase=Path('build/bend-profiles/first-pass-allocation-counts/bend2');dst=Path('build/bend-profiles/first-pass-allocation-stacks/bend2');shutil.copytree(base,dst)\np=dst/'bend.ts';s=p.read_text();s='''export const allocationStacks: Record<string, number> = {};\nfunction sampleAllocation(kind: string): void {\n  if ((allocationCounts[kind] & 8191) !== 0) return;\n  const key = kind + \"\\\\n\" + new Error().stack!.split(\"\\\\n\").slice(2, 13).join(\"\\\\n\");\n  allocationStacks[key] = (allocationStacks[key] ?? 0) + 1;\n}\n'''+s\nfor tag in ['ADT','Ctr','All','Ann','Var','Bin']:\n line=f'allocationCounts.{tag} = (allocationCounts.{tag} ?? 0) + 1;'\n s=s.replace(line,line+f' sampleAllocation(\"{tag}\");')\np.write_text(s)\np=dst/'comp.ts';s=p.read_text()\nfor stage in ['FRONT','CARB','PASS']:\n anchor=f'console.error(\"ALLOC_{stage}\", JSON.stringify(Bend.allocationCounts));'\n s=s.replace(anchor,anchor+f'\\n  console.error(\"STACK_{stage}\", JSON.stringify(Bend.allocationStacks));\\n  for(const k of Object.keys(Bend.allocationStacks)) delete Bend.allocationStacks[k];')\np.write_text(s)\n"
