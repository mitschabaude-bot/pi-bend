{
  "scope": "Unadopted two-line lifetime experiment: drop unused old File before computing next optimization pass, without adding GC calls. Smaller actual stream-error fixture emitted identical C, with no material sampled peak reduction. Shared-host single measurements are not controlled performance evidence or a demonstrated fix for the larger default-provider cliff.",
  "patch": "--- a/bend2/comp.ts\n+++ b/bend2/comp.ts\n@@ -2871,11 +2871,12 @@\n   };\n   // Emitted callees first until a pass changes nothing (own, hot and poly\n   // only grow): that pass is kept.\n-  let fl: File;\n+  let fl: File | undefined;\n   let was: string;\n   do {\n     was = facts();\n     ++profilePass; profileMark(\"pass-start\");\n+    fl = undefined;\n     fl = pass(done_defs(cb).reverse());\n     profileMark(\"pass-end\", {segments:fl.segs.length, own:cb.own.size, hot:cb.hot.size, stat:cb.stat.size});\n     Bun.gc(true); profileMark(\"pass-after-gc\");\n",
