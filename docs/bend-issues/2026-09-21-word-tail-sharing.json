  "patch": "--- a/bend.ts\n+++ b/bend.ts\n@@ -1144,10 +1144,20 @@\n   const words = s === undefined ? undefined : WORD_LITERALS.get(s);\n   const cached = words?.get(n);\n   if (cached !== undefined) return cached;\n-  let out: LTerm = Ctr(\"WNil\", [], s);\n+  const seed = words?.entries().next().value;\n+  let bits = 32;\n+  let out: LTerm;\n+  if (seed !== undefined) {\n+    // Above the highest differing bit, the same-span words share a tail.\n+    bits = 32 - Math.clz32(n ^ seed[0]);\n+    out = seed[1];\n+    for (let i = 0; i < bits; i++) out = (out as Extract<LTerm, { $: \"Ctr\" }>).x[1];\n+  } else {\n+    out = Ctr(\"WNil\", [], s);\n+  }\n   const zero: LTerm = Ctr(\"False\", [], s);\n   const one: LTerm = Ctr(\"True\", [], s);\n-  for (let i = 31; i >= 0; i--) {\n+  for (let i = bits - 1; i >= 0; i--) {\n     out = Ctr(\"WCon\", [(n >>> i) & 1 ? one : zero, out], s);\n   }\n   WORD_TREES.add(out);\n",
