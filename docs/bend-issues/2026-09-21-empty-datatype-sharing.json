  "patch": "--- a/bend.ts\n+++ b/bend.ts\n@@ -398,7 +398,18 @@\n   return { $: \"App\", f, x, s };\n }\n \n+const EMPTY_ADTS = new WeakMap<Span, Map<Name, HTerm>>();\n+\n export function ADT<X>(k: Name, x: TermOf<X>[], s?: Span, r: Name[] = []): TermOf<X> {\n+  if (x.length === 0 && r.length === 0 && s !== undefined) {\n+    let cells = EMPTY_ADTS.get(s);\n+    const got = cells?.get(k);\n+    if (got !== undefined) return got as TermOf<X>;\n+    const out = { $: \"ADT\", k, x, r, s } as TermOf<X>;\n+    if (cells === undefined) EMPTY_ADTS.set(s, cells = new Map());\n+    cells.set(k, out as HTerm);\n+    return out;\n+  }\n   return { $: \"ADT\", k, x, r, s };\n }\n \n",
