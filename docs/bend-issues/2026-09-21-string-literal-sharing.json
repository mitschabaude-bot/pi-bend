  "patch": "--- a/bend.ts\n+++ b/bend.ts\n@@ -707,6 +707,7 @@\n \n // Literal word trees are closed and immutable in either term representation.\n const WORD_TREES = new WeakSet<object>();\n+const STRING_TREES = new WeakSet<object>();\n const WORD_LITERALS = new WeakMap<Span, Map<number, LTerm>>();\n \n export function word_is_literal(tm: HTerm): boolean {\n@@ -779,7 +780,7 @@\n       return ADT(tm.k, tm.x.map((x) => term_higher(x, env)), tm.s, tm.r);\n     }\n     case \"Ctr\": {\n-      if (WORD_TREES.has(tm)) return tm as HTerm;\n+      if (WORD_TREES.has(tm) || STRING_TREES.has(tm)) return tm as HTerm;\n       return Ctr(tm.k, tm.x.map((x) => term_higher(x, env)), tm.s);\n     }\n     case \"Mat\": {\n@@ -848,7 +849,7 @@\n       return ADT(tm.k, tm.x.map((x) => term_lower(x, d)), tm.s, tm.r);\n     }\n     case \"Ctr\": {\n-      if (WORD_TREES.has(tm)) return tm as LTerm;\n+      if (WORD_TREES.has(tm) || STRING_TREES.has(tm)) return tm as LTerm;\n       return Ctr(tm.k, tm.x.map((x) => term_lower(x, d)), tm.s);\n     }\n     case \"Mat\": {\n@@ -2004,9 +2005,11 @@\n         cs.push(parse_char(p));\n       }\n       const spn = parse_span(p, beg);\n-      return cs.reduceRight<LTerm>((out, c) =>\n-        Ctr(\"SCon\", [Ctr(\"Chr\", [u32_to_term(c, spn)], spn), out], spn),\n+      const out = cs.reduceRight<LTerm>((tail, c) =>\n+        Ctr(\"SCon\", [Ctr(\"Chr\", [u32_to_term(c, spn)], spn), tail], spn),\n         Ctr(\"SNil\", [], spn));\n+      STRING_TREES.add(out);\n+      return out;\n     }\n     case \"?\": {\n       parse_bump(p);\n@@ -3573,6 +3576,11 @@\n       }\n       const tel = tele_fill(book, ctr.T, t_wnf.x, ctx, lhs.def, tm.s);\n       const { xs, us } = tele_check(book, lhs, tel, tm.x, qt, ctx, d, tm.s);\n+      // Parsed strings contain only closed, parameter-free String/Char/U32 values.\n+      // Keep their source tree after all constructor/field validation above.\n+      if (t_wnf.k === \"String\" && STRING_TREES.has(tm)) {\n+        return Check(tm as LTerm, ty, us);\n+      }\n       // A checked literal word is emitted atomically; its bit tree needs no\n       // per-bit type annotations. Validation above still checks every field.\n       const word = (t_wnf.k === \"U32\" || t_wnf.k === \"F32\")\n",
