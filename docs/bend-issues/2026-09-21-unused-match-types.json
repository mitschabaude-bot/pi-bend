{
  "status": "Adopted in ordinary installation and default project compiler; excessive memory remains unresolved.",
  "changes": [
    "Only construct a Nat lookup-table result type when a Nat table is a candidate; only construct the native output layout when a table is actually emitted. Both backends retain Nat table behavior.",
    "Constructor field checking still validates every field with its dependent type and demand. Its caller now declines the unused final telescope result. Default tele_check callers retain the result and the original return type. Overloads prevent reading a missing result.",
    "At the last match field, the recursive goal builder does not instantiate an unused telescope result: its zero-field case computes the dependent result from t_all.B as before."
  ],
  "incremental_patch": "--- a/bend2/bend.ts\n+++ b/bend2/bend.ts\n@@ -1129,7 +1129,9 @@\n   return out;\n }\n \n-export function tele_check(book: Book, lhs: LHS, tel: HTerm, xs: HTerm[], qt: Quant, ctx: Ctx, d: number, s?: Span): { xs: LTerm[]; us: Uses; tel: HTerm } {\n+export function tele_check(book: Book, lhs: LHS, tel: HTerm, xs: HTerm[], qt: Quant, ctx: Ctx, d: number, s: Span | undefined, need_tip: false): { xs: LTerm[]; us: Uses };\n+export function tele_check(book: Book, lhs: LHS, tel: HTerm, xs: HTerm[], qt: Quant, ctx: Ctx, d: number, s?: Span, need_tip?: true): { xs: LTerm[]; us: Uses; tel: HTerm };\n+export function tele_check(book: Book, lhs: LHS, tel: HTerm, xs: HTerm[], qt: Quant, ctx: Ctx, d: number, s?: Span, need_tip = true): { xs: LTerm[]; us: Uses; tel?: HTerm } {\n   const out: LTerm[] = [];\n   let us = uses_nil();\n   for (const x of xs) {\n@@ -1138,9 +1140,9 @@\n     const x_chk = term_check(book, lhs, x, t_dem, t_all.A, ctx, d);\n     out.push(x_chk.tm);\n     us  = uses_add(us, x_chk.us);\n-    tel = t_all.B(x);\n-  }\n-  return { xs: out, us, tel };\n+    if (need_tip || out.length < xs.length) tel = t_all.B(x);\n+  }\n+  return need_tip ? { xs: out, us, tel } : { xs: out, us };\n }\n \n export function tele_unbind(book: Book, T: HTerm): { doms: Array<[Quant, Name, HTerm]>; ret: HTerm } {\n@@ -3586,7 +3588,7 @@\n         throw Err(book, ctx, tm.k + \" with \" + String(ctr.n) + (ctr.n === 1 ? \" field\" : \" fields\"), tm, tm.s, lhs.def);\n       }\n       const tel = tele_fill(book, ctr.T, t_wnf.x, ctx, lhs.def, tm.s);\n-      const { xs, us } = tele_check(book, lhs, tel, tm.x, qt, ctx, d, tm.s);\n+      const { xs, us } = tele_check(book, lhs, tel, tm.x, qt, ctx, d, tm.s, false);\n       // Parsed strings contain only closed, parameter-free String/Char/U32 values.\n       // Keep their source tree after all constructor/field validation above.\n       if (t_wnf.k === \"String\" && STRING_TREES.has(tm)) {\n@@ -3652,7 +3654,8 @@\n               const c_all = tele_head(book, cur, ctx, lhs.def, b.s);\n               const c_dem = c_all.q.$ === \"None\" ? None() : c_all.q.$ === \"Lone\" ? t_all.q : quant_add(t_all.q, t_all.q);\n               return All(c_dem, c_all.k, c_all.i, c_all.A, (x: HTerm) => {\n-                return term_check_mat_goal(c_all.B(x), n - 1, xs.concat([x]));\n+                // At n=0 the telescope is unused; t_all.B determines the result.\n+                return term_check_mat_goal(n === 1 ? cur : c_all.B(x), n - 1, xs.concat([x]));\n               }, b.s);\n             }\n           }\n--- a/bend2/comp.ts\n+++ b/bend2/comp.ts\n@@ -2692,14 +2692,13 @@\n     `((${bits} >> ${i}) & 1)`), lay) : val_to(fl, args[0], lay), \"s\");\n   const total = Bend.book_adt(fl.book, adt, Bend.Emp()).c.length;\n   const { arms, end } = mat_arms(x);\n-  const ret = lay_of(fl.book, all.B(DUMMY));\n   const sw = s.ws[0];\n   const ls = adt.k === \"Nat\" ? emit_nat(x) : null;\n-  const id = emit_tab(fl, ls, all.B(DUMMY));\n+  const id = ls === null ? null : emit_tab(fl, ls, all.B(DUMMY));\n   if (id !== null) {\n     bind_dead(fl, []);\n     return emit_put(fl, dst, val_new(\n-      [`TAB_AT(TAB_${id}, ${sw}, ${ls!.length - 1})`], ret));\n+      [`TAB_AT(TAB_${id}, ${sw}, ${ls!.length - 1})`], lay_of(fl.book, all.B(DUMMY))));\n   }\n   const lv: Level[] = ls !== null\n     ? ls.map(([h, n], i): Level => [`${sw} == ${i}`, h, () =>\n@@ -3113,7 +3112,7 @@\n       });\n     }\n     const ls = adt.k === \"Nat\" ? emit_nat(x) : null;\n-    const id = emit_tab(fl, ls, all.B(DUMMY));\n+    const id = ls === null ? null : emit_tab(fl, ls, all.B(DUMMY));\n     if (id !== null) {\n       return file_push(fl, `return TAB_${id}[Math.min(Number(${s}), ${\n         ls!.length - 1})];`);\n",
