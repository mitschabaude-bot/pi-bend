  "selective_patch": "--- a/bend.ts\n+++ b/bend.ts\n@@ -2589,6 +2589,19 @@\n   parse_def_body(p, book, k, def, vars, n0);\n }\n \n+// Literal word patterns expand into bit trees. Keep their reconstruction\n+// substitutions lazy instead of materializing every failure branch up front.\n+function body_word_pattern(b: Body): boolean {\n+  const word = (p: Patt): boolean => p.$ === \"PCtr\" && (\n+    ((p.k === \"U32\" || p.k === \"F32\") && u32_from_term(patt_term(p), p.k) !== null)\n+    || p.x.some(word));\n+  switch (b.$) {\n+    case \"Reply\": return false;\n+    case \"Local\": return b.k.some(word) || body_word_pattern(b.f);\n+    case \"Match\": return b.r.some((r) => r.p.some(word) || body_word_pattern(r.f));\n+  }\n+}\n+\n export function parse_def_body(p: Parse, book: Book, k: Name, def: Def, vars: PVar[], n0: number): void {\n   parse_eat(p, \":\");\n   if (parse_at_word(p, \"import\")) {\n@@ -2611,7 +2624,8 @@\n   }\n   const b = parse_body(p);\n   parse_close(p, n0);\n-  def.v = term_higher(term_lower(term_higher(body_flatten(b, vars, () => p.sc.frs++))));\n+  const value = term_higher(body_flatten(b, vars, () => p.sc.frs++));\n+  def.v = body_word_pattern(b) ? value : term_higher(term_lower(value));\n   book.order.push(k);\n }\n \n",
