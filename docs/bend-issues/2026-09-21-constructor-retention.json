    "release_script": "import * as Bend from '../bend-profiles/dns-transport-teles/bend2/bend.ts';\nconst book=Bend.book_nil();\n(globalThis as any).retentionBook=book;\nasync function measure(phase:string) {\n await Bun.sleep(0);\n Bun.gc(true);\n console.log(JSON.stringify({phase,...process.memoryUsage(),definitions:Object.keys(book.tlds).length}));\n}\nawait Bend.book_load(book,process.cwd()+'/'+process.argv[2],'',new Map());\nawait measure('loaded');\nBend.book_valid(book);\nconsole.log('All terms check; diagnostic releases occur only after validation.');\nawait measure('checked');\nfor (const d of Object.values(book.tlds)) if (d.$==='Def') delete d.e;\nawait measure('without-checked-bodies');\nfor (const d of Object.values(book.tlds)) if (d.$==='Def') d.v=null;\nawait measure('without-source-bodies');\nbook.tmps=Object.create(null);\nawait measure('without-templates');\n",
    "annotation_release_script": "import * as Bend from '../bend-profiles/dns-transport-teles/bend2/bend.ts';\nconst book=Bend.book_nil();\n(globalThis as any).retentionBook=book;\nasync function measure(phase:string) {\n await Bun.sleep(0);\n Bun.gc(true);\n console.log(JSON.stringify({phase,...process.memoryUsage(),definitions:Object.keys(book.tlds).length}));\n}\nawait Bend.book_load(book,process.cwd()+'/'+process.argv[2],'',new Map());\nawait measure('loaded');\nBend.book_valid(book);\nconsole.log('All terms check; diagnostic releases occur only after validation.');\nawait measure('checked');\nconst counts: Record<string,number> = {};\nfunction removeAnnotations() {\n  const seen = new WeakSet<object>();\n  const stack: any[] = Object.values(book.tlds).flatMap(d => d.$==='Def' && d.e ? [d.e] : []);\n  while (stack.length) {\n    const t=stack.pop();\n    if (!t || typeof t!=='object' || seen.has(t)) continue;\n    seen.add(t);\n    counts[t.$]=(counts[t.$]??0)+1;\n    if (t.$==='Ann') {stack.push(t.x);delete t.T;continue;}\n    for (const k of ['f','A','B','a','b','h','m','e','p','g','T']) if (t[k] && typeof t[k]==='object') stack.push(t[k]);\n    if (t.x && typeof t.x==='object' && !Array.isArray(t.x)) stack.push(t.x);\n    for (const k of ['x','v']) if (Array.isArray(t[k])) stack.push(...t[k]);\n  }\n}\nremoveAnnotations();\nconsole.log(JSON.stringify({phase:'checked-syntax-counts',counts}));\nawait measure('without-annotation-types');\nfor (const d of Object.values(book.tlds)) if (d.$==='Def') delete d.e;\nawait measure('without-checked-bodies');\nfor (const d of Object.values(book.tlds)) if (d.$==='Def') d.v=null;\nawait measure('without-source-bodies');\nbook.tmps=Object.create(null);\nawait measure('without-templates');\n",
