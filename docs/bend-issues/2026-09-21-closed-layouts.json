  "status": "Adopted in ordinary/default native compilers. Excessive memory remains unresolved.",
  "patch": "--- a/comp.ts\n+++ b/comp.ts\n@@ -593,6 +593,7 @@\n const TELES: Map<HTerm, ReturnType<typeof Bend.tele_unbind>> = new Map();\n const TAILS = new Map<Bend.Ctr, Map<HTerm | number, Dom[]>>();\n const LAYS = new Map<HTerm | null, Lay>();\n+const CLOSED_LAYS = new Map<Bend.ADT, Map<number, Lay>>();\n \n const SRCS: Map<Bend.Name, Src> = new Map();\n \n@@ -680,7 +681,7 @@\n \n function memo_gc(): void {\n   PROBES.length = 1; // Keep DUMMY; opened binders belong to this definition.\n-  [OPENS, USES, FOLDS, SPINES, CONSTS, TELES, TAILS, LAYS].forEach((m) => m.clear());\n+  [OPENS, USES, FOLDS, SPINES, CONSTS, TELES, TAILS, LAYS, CLOSED_LAYS].forEach((m) => m.clear());\n }\n \n // Probe\n@@ -942,9 +943,16 @@\n       return BOX;\n     }\n     const tld = book.tlds[t.k];\n-    return WORDS[t.k] ?? (t.k === \"Array\" || t.k === \"IO.OP\" || tld?.$ !== \"ADT\"\n-      || lay_cyclic(book, t.k) ? BOX : lay_pack(tld.c.map((c): Arm =>\n-      ({ k: c.k, fs: lay_fields(book, ctr_doms(book, c, t.x)) }))));\n+    if (WORDS[t.k] !== undefined) return WORDS[t.k];\n+    if (t.k === \"Array\" || t.k === \"IO.OP\" || tld?.$ !== \"ADT\"\n+      || lay_cyclic(book, t.k)) return BOX;\n+    const get = () => lay_pack(tld.c.map((c): Arm =>\n+      ({ k: c.k, fs: lay_fields(book, ctr_doms(book, c, t.x)) })));\n+    const key = tld.n === 0 && t.x.length === 0 ? 0\n+      : t.k === \"Word.Con\" && t.x.length === 1\n+        ? ctr_index(book.ctrs.WCon, t.x[0]) : null;\n+    return typeof key === \"number\"\n+      ? memo(memo(CLOSED_LAYS, tld, () => new Map()), key, get) : get();\n   });\n }\n \n",
  "source_audit": [
    "Layout depends on the ADT definition and its parameters. The new cache keys by that exact definition object.",
    "Parameter-free datatypes use one entry only when both declaration parameter count and supplied argument count are zero.",
    "Word.Con uses the existing bounded ctr_index recognizer on its sole parameter: literal Nat values0..31 only. Nonliteral/longer indices fall back to original computation.",
    "Primitive machine words, arrays, IO operations and cyclic types still use the original early layout results.",
    "lay_fields creates fresh Field records. lay_pack mutates those new field offsets and its new ks array; it does not mutate previously published child Lay objects.",
    "The new cache clears at the existing per-definition boundary alongside LAYS/TAILS. No checker or runtime changes."
  ],
