=== b || JSON.stringify(a) === JSON.stringify(b);\n  if (lay_eq(a,b) !== expected) throw Error(\"Layout comparison mismatch\");\n  comparisons++;\n}\nconsole.log(`${comparisons} valid-layout comparisons agree with the previous implementation`);\n"
