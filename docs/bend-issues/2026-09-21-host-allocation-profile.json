    "driver_source": "import {Session} from 'node:inspector/promises';\nimport * as fs from 'node:fs';\nimport * as path from 'node:path';\nimport * as Bend from '../bend-native-toolchain/bend2/bend.ts';\nimport * as Comp from '../bend-native-toolchain/bend2/comp.ts';\n\n// Diagnostic host adapter only. Compiler sources are unchanged.\nObject.assign(globalThis, {Bun: {gc: () => globalThis.gc!()}});\nconst [source, output] = process.argv.slice(2);\nfs.mkdirSync(output, {recursive: true});\nconst session = new Session();\nsession.connect();\nasync function stage<T>(name: string, run: () => T | Promise<T>): Promise<T> {\n  await session.post('HeapProfiler.startSampling', {\n    samplingInterval: 65536,\n    includeObjectsCollectedByMajorGC: true,\n    includeObjectsCollectedByMinorGC: true,\n  });\n  const value = await run();\n  const {profile} = await session.post('HeapProfiler.stopSampling');\n  fs.writeFileSync(path.join(output, name + '.heapprofile'), JSON.stringify(profile));\n  console.log(name, process.memoryUsage());\n  return value;\n}\nconst book = Bend.book_nil();\nawait stage('load', () => Bend.book_load(book, path.resolve(source), '', new Map()));\nawait stage('check', () => Bend.book_valid(book));\nif (book.hols + book.open !== 0) throw new Error('Unfilled definitions');\nconst c = await stage('compile', () => Comp.compile_book(book));\nfs.writeFileSync(path.join(output, 'output.c'), c);\nsession.disconnect();\n",
